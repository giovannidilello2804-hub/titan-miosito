# ==========================================
# Raspberry Pi Dual Server Configuration
# ==========================================

# Password del Database MariaDB (Personalizza queste password!)
MYSQL_ROOT_PASSWORD=SuperSecretRootPassword123!
MYSQL_PASSWORD=NextcloudDbPassword123!
MYSQL_DATABASE=nextcloud
MYSQL_USER=nextcloud

# Amministratore Nextcloud Iniziale
NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD=AdminCloudPassword123!

# Porte Locali dei Container
NEXTCLOUD_PORT=8080
WEBSERVER_PORT=8081
PROXY_PORT=80
PROXY_SSL_PORT=443
